#: dat/missions/neutral/kidnapped/traffic_01.lua:259
msgid ""
"\"I don't think he is here. He must be in one of the other systems. Please "
"hurry!\""
msgstr ""

#: dat/missions/neutral/kidnapped/traffic_01.lua:262
msgid "\"I think this is it! We found him!\""
msgstr ""

