#: dat/missions/neutral/antlejos/ant02.lua:94
#: dat/missions/neutral/antlejos/ant03.lua:94
#: dat/missions/neutral/antlejos/ant04.lua:101
#: dat/missions/neutral/antlejos/ant_supplies.lua:106
