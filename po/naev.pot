#. Do more pulses over time
#. Can get knocked off by weapon knockback, go back
#. Broadcast over
#: dat/missions/taiomi/taiomi05.lua:257
msgid "Nothing… Let us move on."
msgstr ""

#. Find location
#: dat/missions/taiomi/taiomi05.lua:271
