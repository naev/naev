#: dat/missions/dvaered/recruitment/dv_goddard.lua:51
msgid "Saboteurs"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:51
msgid "A group of saboteurs"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:60
msgid "Poor lone little Llama!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:61
msgid "I am the 'Silent Death'!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:62
msgid "I'm as silent as silence itself!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:63
msgid "I'm as deadly as… er… death!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:64
msgid "Enjoy your last moments as they are your… er… last moments!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:65
msgid "Ahahahahah!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:66
msgid "I know no mercy!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:67
msgid "I am cruel and ruthless! And heartless! And… and unkind!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:68
msgid "Your destiny is sealed!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:70
msgid "Hey? Stop shooting at me!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:71
msgid "Please don't kill me!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:72
msgid "I beg you!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:73
msgid "Noooooooo!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:74
msgid "Please! Have mercy!"
msgstr ""

#: dat/missions/dvaered/recruitment/dv_goddard.lua:75
msgid "I can make you rich if you spare my life!"
msgstr ""

