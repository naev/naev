msgstr ""

#: dat/missions/neutral/antlejos/ant05.lua:179
msgid "Supply Ship Entry Point"
msgstr ""

#: dat/missions/neutral/antlejos/ant05.lua:191
msgid "The supply ships will be incoming shortly!"
msgstr ""

