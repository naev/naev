msgid "Kotori"
msgstr ""

#: dat/spob/kraft_i.xml:1
msgid "Kraft I"
msgstr ""

#: dat/spob/kraft_ii.xml:1
msgid "Kraft II"
msgstr ""

#: dat/spob/kraft_iv.xml:1
