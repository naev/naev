#.
#.
#.
#. Non-persistent state
#. Forward-declared functions
#. Mission info stuff
#: dat/missions/zalek/neburesearch/neburesearch_01.lua:46
msgid "Escort the transport ship to {pnt} in the {sys} system"
msgstr ""

#: dat/missions/zalek/neburesearch/neburesearch_01.lua:47
#: dat/missions/zalek/neburesearch/neburesearch_04.lua:90
#: dat/missions/zalek/neburesearch/neburesearch_04.lua:102
#: dat/missions/zalek/neburesearch/neburesearch_05.lua:59
