#: dat/missions/wildspace/marker.lua:22
msgid ""
"You obtained information about a jump to Wild Space. Maybe you should see "
"what is there."
msgstr ""

#: dat/missions/wildspace/marker.lua:25
msgid "Jump to Wild Space"
msgstr ""

