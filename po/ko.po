msgstr "키 이름 '%s'은(는) 어떤 키와도 일치하지 않습니다."

msgid "Found keybind with no key field!"
msgstr "키 필드가 없는 키 바인딩이 발견되었습니다!"

msgid "Found keybind with invalid key field!"
msgstr "잘못된 key 필드가 있는 키 바인드를 찾았습니다!"

#, c-format
