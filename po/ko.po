msgstr "* [무기 세트](mechanics/weaponsets)"

msgid "* [Launchers](mechanics/launchers)"
msgstr "* [발사기](mechanics/launchers)"

msgid "## Advanced"
msgstr "## 고급"

msgid "* [Boarding](mechanics/boarding)"
msgstr "* [나포](mechanics/boarding)"

