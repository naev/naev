msgstr "{fname} 영토"

msgid "The Nebula"
msgstr "성운"

msgid "Grim Reminder of Our Fragility"
msgstr "우리의 연약함을 상기시키는 암울한 증거"

msgid "Northern Stellar Winds"
msgstr "북부 성간풍"

