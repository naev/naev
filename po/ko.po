msgid "\"Landing access authorized.\""
msgstr "\"착륙 접근 승인.\""

msgid "\"You are not authorized to land here.\""
msgstr "\"이곳에 착륙할 권한이 없습니다.\""

msgid "\"Military clearance approved.\""
msgstr "\"군사 허가 승인.\""

msgid "\"Military authorization cleared.\""
