msgstr "이상한 난파선"

#. Clean up stuff
#.
#. <?xml version='1.0' encoding='utf8'?>
#. <event name="POI Generator">
#. <location>load</location>
#. <chance>100</chance>
#. <priority>11</priority>
#. </event>
#. --
