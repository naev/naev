msgid "Corsair"
msgstr "코르세어"

msgid "Corsair set bonus."
msgstr "코르세어 세트 보너스."

msgid "Plasma is interfering with the weapon systems!"
msgstr "플라즈마가 무기 시스템즈을 방해하고 있습니다!"

msgid "Cyberspace"
msgstr "사이버스페이스"

msgid "You are in cyberspace!"
msgstr "당신은 사이버스페이스에 있습니다!"

msgid "Ethereal"
msgstr "에테리얼"

msgid "Ship is ethereal."
msgstr "함선이 에테르 상태입니다."

msgid "Fade-In"
msgstr "페이드인"

msgid "Fading in!"
msgstr "페이드인 중!"

msgid "Fade-In Black"
msgstr "검정 페이드인"

msgid "Fade-Out"
msgstr "페이드아웃"

msgid "Fading Out!"
msgstr "페이드아웃 중!"

msgid "Fade-Out Black"
msgstr "검정 페이드아웃"

msgid "Fade-Out Norender"
msgstr "렌더 없음 페이드아웃"

msgid "Your ship just used Feather Drive!"
msgstr "함선이 방금 페더 드라이브를 사용했습니다!"

