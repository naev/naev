msgid "You found #o{title} - {subtitle}#0!"
msgstr "#o{title} - {subtitle}#0을(를) 발견했다!"

msgid "You found #o{title}#0!"
msgstr "#o{title}#0을(를) 발견했다!"

#. Log and message
