msgstr "제국을 위하여!"

msgid "Beginning activation countdown!"
msgstr "활성화 카운트다운 시작!"

msgid "For glory!"
msgstr "영광을 위하여!"

msgid "Counting down!"
msgstr "카운트다운 중!"

msgid "For science!"
msgstr "과학을 위하여!"

msgid "Commencing procedure!"
msgstr "절차 개시!"

msgid "For the Sirichana!"
msgstr "시리차나를 위하여!"

msgid "Starting ritual!"
msgstr "의식 시작!"

msgid "Enter the maw!"
msgstr "아가리 속으로 들어가라!"

msgid "Time has come!"
msgstr "때가 왔다!"

