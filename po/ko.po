msgstr "{sys} 성계에서 적대 세력과 조우"

msgid "Jumped from the {1} system to the {2} system"
msgstr "{1} 성계에서 {2} 성계로 점프함"

msgid "Landed on {pnt} in the {sys} system"
msgstr "{sys} 성계의 {pnt}에 착륙함"

