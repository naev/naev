#. </notes>
#. </mission>
#. --
#.
#. Introduction to the Onion Society campaign
#. --
#. Create the mission
#. This will mess up strings quite badly
msgid "NULL"
msgstr "NULL"

msgid ""
"Shipment to {pnt} in {sys} ({tonnes}) #oWARNING: Invalid Formatting "
"Detected#0"
msgstr ""
"Livraison vers {pnt}, dans {sys} ({tonnes}) #oATTENTION : formatage invalide "
"détecté#0"

msgid "∞ t"
msgstr "∞ t"

msgid "Sol system"
msgstr "Système de Sol"

msgid "INVALID RECORD"
msgstr "ENREGISTREMENT INVALIDE"

msgid "#nCargo:#0 {amount}"
msgstr "#nCargo :#0 {amount}"

msgid ""
"ERROR: NoncurrentModificationExceptionException: Exception modified while "
"excepting."
msgstr ""
"ERREUR : NoncurrentModificationExceptionException : Exception modifiée "
"pendant le traitement d'une exception."

msgid "-∞ ¤"
msgstr "-∞ ¤"

#. Messes up the text a bit every time the player jumps
msgid "Strange Shipment"
msgstr "Colis étrange"

msgid "Deliver a small package to {pnt} ({sys} system)"
msgstr "Livrer le petit paquet à {pnt} (système {sys})"

msgid "System Error"
msgstr "Erreur Système"

msgid ""
"You try to accept the mission, but a bunch of errors pop out, and the "
"mission computer ends up crashing and rebooting. That was weird."
msgstr ""
"Vous tentez d'accepter la mission, mais une avalanche de messages d'erreur "
"apparaît avant que l'ordinateur de mission ne plante complètement puis "
"redémarre. Étrange..."

#. Generate next iteration of the mission
msgid "Shipment to Shipment to Shipment to Shipment to"
msgstr "Livraison vers Livraison vers Livraison vers Livraison vers"

msgid "#rERROR: BufferOverru"
msgstr "#rERREUR : BufferOverru"

