msgstr ""
"#AVERTISSEMENT :#0 Cette mission est illégale et vous vaudra des ennuis avec "
"les autorités !"

msgid "Assassination"
msgstr "Assassinat"

msgid "Fly to the {sys} system before {time_limit} ({time} remaining)"
msgstr ""
"Rendez-vous sur le système {sys} avant {time_limit} (il vous reste {time})"

msgid "Target got away."
msgstr "La cible a pris la fuite."

#. Nothing to do.
