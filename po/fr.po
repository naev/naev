msgstr "{item} ({tokens})"

#. Add special ticket
msgid "Special Spa Ticket ({tokens})"
msgstr "Billet Spa Prestige ({tokens})"

#. Buying stuff
msgid ""
"\"ARE YOU SURE YOU WANT TO TRADE IN FOR THE '#w{item}#0'? THE DESCRIPTION IS "
"AS FOLLOWS:\"\n"
"#w{description}#0"
msgstr ""
"\"ÊTES-VOUS CERTAIN DE VOULOIR ÉCHANGER VOS JETONS CONTRE \"#w{item}#0\" ? "
"EN VOICI LA DESCRIPTION :\"\n"
"#w{description}#0"

msgid "You gambled for this ship at {pnt} in the {sys} system."
msgstr ""
"Vous avez remporté ce vaisseau en jouant à {pnt}, dans le système {sys}."

msgid "\"THANK YOU FOR YOUR BUSINESS.\""
msgstr "\"MERCI DE VOTRE VISITE.\""

#. Buying the ticket
msgid ""
"\"ARE YOU SURE YOU WANT TO TRADE IN FOR THE PREMIUM AND EXCLUSIVE SPECIAL "
"SPA TICKET?\"\n"
"\"THIS TICKET WILL ALLOW YOU TO ENTER A LOTTERY TO WIN AN EXCLUSIVE RELAXING "
"TIME AT THE MINERVA STATION ALL NATURAL SPA WITH CYBORG CHICKEN.\""
msgstr ""
"\"ÊTES-VOUS CERTAIN DE VOULOIR ÉCHANGER VOS JETONS CONTRE CE BILLET SPA "
"PRESTIGE EXCLUSIF ?\"\n"
"\"CE BILLET VOUS PERMET DE PARTICIPER À UNE LOTERIE DONT LE GAGNANT "
"REMPORTERA UNE SÉANCE DE DÉTENTE EXCLUSIVE AUX SOURCES THERMALES NATURELLES "
"DE LA STATION MINERVE EN COMPAGNIE DE LA POULE CYBORG.\""

