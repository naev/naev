msgid "Long distance cargo transport ({tonnes} of {cargo})"
msgstr "Transport longue distance de {tonnes} de {cargo}"

msgid ""
"Official Empire long distance cargo transport to {pnt} in the {sys} system."
msgstr ""
"Transport Impérial de marchandises (longue distance) vers {pnt} dans le "
"système {sys}."

msgid "Long Distance Empire Shipping"
msgstr "Transport Impérial - Longue distance"

#.
#. <?xml version='1.0' encoding='utf8'?>
#. <mission name="Empire Shipping 1">
#. <unique />
#. <priority>2</priority>
#. <cond>
