#. Add tag-appropriate descriptions
msgid "Dreamer Soul"
msgstr "Âme des Rêveurs"

#. local fmt = require "format"
#. State. Nothing persists.
msgid "The civilian is curling some weights while enjoying a drink."
msgstr "Un civil soulève des haltères tout en sirotant un verre."

msgid "You see a person who seems to be flexing their muscles while drinking."
msgstr "Vous voyez une personne qui bombe les muscles tout en buvant."

msgid ""
"The individual has a large assortment of empty glasses in front of them."
msgstr ""
"Une impressionnante quantité de verres vides est alignée devant cette "
"personne."

msgid "A civilian downing drinks one after another."
msgstr "Un civil enchaîne les verres les uns après les autres."

msgid ""
"This person does their best to read the news terminal despite having a black "
"eye."
msgstr ""
"Malgré son œil au beurre noir, cette personne s'efforce de lire les "
"actualités sur un terminal."

msgid "The person has leaves stuck all over them."
msgstr ""
"Cette personne a des feuilles accrochées un peu partout sur ses vêtements."

msgid "The individual is covered in smut."
msgstr "Cette personne est couverte de suie."

msgid "A civilian with a thin layer of grime on them."
msgstr "Un civil recouvert d'une fine couche de crasse."

msgid "A worker with lots of small pebbles falling off of them."
msgstr "Un ouvrier dont les vêtements sont recouverts de petits cailloux."

msgid "This worker wears a badge that reads \"Miner of the Cycle\"."
msgstr ""
"Cet ouvrier porte un badge sur lequel on peut lire : \"Mineur du cycle\"."

