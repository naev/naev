msgid "Plasma is slowing the ship down!"
msgstr "プラズマが船を遅くする！"

msgid "Plasma Burn"
msgstr "プラズマやけど"

msgid "Plasma is burning the ship!"
msgstr "プラズマが船を焼く！"

msgid "Plasma Burn II"
msgstr "プラズマやけど II"

msgid "Psychic Divinity"
msgstr "心霊の神力"

msgid "Psychic Orb Off"
