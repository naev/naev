msgid "Small Dead or Alive Bounty in {sys}"
msgstr "{sys}での小規模の生死を問わない賞金"

msgid "Moderate Dead or Alive Bounty in {sys}"
msgstr "{sys}での中規模の生死を問わない賞金"

msgid "High Dead or Alive Bounty in {sys}"
