msgid "Black!"
msgstr "黒！"

msgid "Blink"
msgstr "ブリンク"

msgid "Your ship just blinked!"
msgstr "あなたの船はいまブリンクした！"

msgid "Blood Lust"
msgstr "血への渇望"

msgid "The ship has had a taste of blood and wants more!"
msgstr "船が血をなめ、もっと欲しがっている！"

msgid "Chakra Burn"
msgstr "チャクラのやけど"

