#. desc_list["industrial"] = {}
#. desc_list["mining"] = {}
#. desc_list["tourism"] = {}
#. desc_list["medical"] = {}
#. desc_list["trade"] = {}
#. desc_list["old"] = {}
#. desc_list["immigration"] = {}
