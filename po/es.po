#. Set mission details
msgid "Patrol of the {sys} System"
msgstr "Patrulla del Sistema {sys}"

msgid ""
"Patrol specified points in the {sys} system, eliminating any hostiles you "
"encounter.\n"
"\n"
"#nPatrol System:#0 {sys}\n"
"#nPatrol Points:#0 {amount}\n"
"#nExtra Payment:#0 {credits} per point of hostile eliminated"
msgstr ""

#. Mark the system as having a patrol mission
msgid "Already Patrolling"
msgstr "Ya en Patrulla"

msgid "You can only accept a single patrol mission at a given time."
msgstr "Sólo puedes recibir una misión de patrulla al mismo tiempo."

#, lua-format
msgid "Go to indicated point (%d remaining)"
msgid_plural "Go to indicated point (%d remaining)"
msgstr[0] "Ve al punto indicado (%d restante)"
msgstr[1] "Ve al punto indicado (%d restantes)"

msgid "Patrol"
msgstr "Patrulla"

