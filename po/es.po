#. --
#.
#.
#. Mission: Emergency of Immediate Inspiration
#.
#. Description: Take Dr. Mensing to Jorla as fast as possible!
#.
#. Difficulty: Easy
#.
#. --
#. Mission constants
#. mission variables
#. Spaceport bar stuff
#.
#. <?xml version='1.0' encoding='utf8'?>
