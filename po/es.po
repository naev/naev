msgstr "Ciudad Crater"

msgid "Touching the Universe"
msgstr "Tocando el Universo"

msgid "Ship Graveyard"
msgstr "Cementerio de Naves"

msgid "Gambler's Paradise"
msgstr "Paraiso del Jugador"

msgid "Brave your Fate in the #rCrimson Gauntlet#0"
msgstr "Enfréntate a tu destino en el #rGuantelete Carmesí#0"

msgid "The Devastation of Haven"
msgstr "La Devastación de Refugio"

msgid "The Old Wound That Never Heals"
msgstr "La Vieja Herida Que Nunca Sana"

msgid "They Will Never Destroy Us"
msgstr "Nunca Nos Destruirán"

msgid "Any Business is Good Business"
msgstr "Cualquier Negocio es un Buen Negocio"

