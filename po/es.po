msgstr "FLF: Patrulla Simple del Imperio en {sys}"

msgid "FLF: Small Empire patrol in {sys}"
msgstr "FLF: Patrulla Pequeña del Imperio en {sys}"

msgid "FLF: Medium Empire patrol in {sys}"
msgstr "FLF: Patrulla Media del Imperio en {sys}"

msgid "FLF: Large Empire patrol in {sys}"
msgstr "FLF: Patrulla Grande del Imperio en {sys}"

msgid "FLF: Dangerous Empire patrol in {sys}"
msgstr "FLF: Patrulla Peligrosa del Imperio en {sys}"

msgid "FLF: Highly Dangerous Empire patrol in {sys}"
msgstr "FLF: Patrulla Altamente Peligrosa del Imperio en {sys}"

msgid "Eliminate the Empire patrol"
msgstr "Elimina la Patrulla del Imperio"

msgid ""
"There is {n} Empire ship patrolling the {sys} system. Eliminate this ship."
msgid_plural ""
"There is an Empire patrol with {n} ships in the {sys} system. Eliminate this "
"patrol."
msgstr[0] ""
"Hay {n} nave del Imperio patrullando el sistema {sys}. Elimina esta nave."
msgstr[1] ""
"Hay una patrulla del Imperio con {n} naves en el sistema {sys}. Elimina esta "
"patrulla."

msgid " There is a Pacifier among them, so you must proceed with caution."
msgstr ""
" Hay un Pacificador entre ellos, así que debes proceder con precaución."

msgid " There is a Hawking among them, so you must be very careful."
msgstr " Hay un Hawking entre ellos, así que debes tener mucho cuidado."

msgid " You will be accompanied by {n} other FLF pilot for this mission."
msgid_plural ""
" You will be accompanied by {n} other FLF pilots for this mission."
msgstr[0] " Estarás acompañado por {n} otro piloto de FLF para esta misión."
msgstr[1] " Te acompañarán {n} otros pilotos de la FLF para esta misión."

msgid "Alright, let's have at them!"
msgstr "Muy bien, ¡vamos a por ellos!"

