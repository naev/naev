msgid "You approach the Crimson Gauntlet guide."
msgstr "Te acercas al guía del Guantelete Carmesí."

msgid ""
"\"Hello and welcome to the Crimson Gauntlet! You have {emblems}. What would "
"you like to do?\""
msgstr ""
"\"¡Hola y bienvenidos al Guantelete Carmesí! Tienes {emblems}. ¿Qué te "
"gustaría hacer?\""

msgid "Information"
msgstr "Información"

msgid "Trade Emblems"
msgstr "Comerciar con Emblemas"

