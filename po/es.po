#. </cond>
#. <chance>560</chance>
#. <location>Computer</location>
#. <notes>
#. <tier>3</tier>
#. </notes>
#. </mission>
#. --
#.
#.
#. Patrol
#.
#. Generalized replacement for Dvaered patrol mission. Can work with any
#. faction.
#.
#. --
#. luacheck: globals abandon_text msg pay_text (shared with derived mission pirate.patrol)
#. Half as much as system bounty missions, maybe needs tweaking
msgid ""
"After going through some paperwork, an officer hands you your pay and sends "
"you off."
msgstr ""
"Después de pasar por el papeleo, un oficial te entrega tu paga y se despide."

msgid ""
"A tired-looking officer verifies your mission log and hands you your pay."
msgstr ""
"Un oficial de aspecto cansado verifica el registro de tu misión y te entrega "
"la paga."

msgid ""
"The officer you deal with thanks you for your work, hands you your pay, and "
"sends you off."
msgstr ""
"El funcionario con el que tratas te agradece tu trabajo, te entrega la paga "
"y se despide."

msgid ""
"An officer goes through the necessary paperwork, looking bored the entire "
"time, and hands you your fee."
msgstr ""
"Un funcionario revisa el papeleo necesario, con cara de aburrimiento todo el "
"tiempo, y te entrega tu pago."

msgid ""
"You are sent a message informing you that landing in the middle of a patrol "
"mission is considered to be abandonment. As such, your contract is void and "
"you will not receive payment."
msgstr ""
"Se te ha enviado un mensaje informándote de que aterrizar en medio de una "
"misión de patrulla se considera un abandono. Por lo tanto, tu contrato queda "
"anulado y no recibirás ningún pago."

#. Messages
msgid "Point secure."
msgstr "Punto seguro."

msgid "Hostiles detected. Engage hostiles."
msgstr "Hostiles detectados. Enfréntate a los hostiles."

msgid "Patrol complete. You can now collect your pay."
msgstr "Patrulla completa. Ahora puedes cobrar tu paga."

msgid "You showed up too late."
msgstr "Llegaste demasiado tarde."

#. Nothing to do.
msgid "You have left the {sys} system."
msgstr "Has dejado el sistema {sys}."

msgid "Eliminate hostiles"
msgstr "Elimina a los hostiles"

msgid "Land in {fct} territory to collect your pay"
msgstr "Aterriza en el territorio de {fct} para cobrar tu paga"

#. Get the number of enemies in a particular system
#. Try to cache the route to make it so that the same route doesn't appear over and over
#. Regenerate
