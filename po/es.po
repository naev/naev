msgid "Saboteurs"
msgstr "Saboteadores"

msgid "A group of saboteurs"
msgstr "Un grupo de saboteadores"

msgid "Poor lone little Llama!"
msgstr "¡Pobre llamita solitaria!"

msgid "I am the 'Silent Death'!"
msgstr "¡Soy la \"Muerte Silenciosa\"!"

msgid "I'm as silent as silence itself!"
msgstr "¡Soy tan silencioso como el silencio mismo!"

msgid "I'm as deadly as… er… death!"
msgstr "¡Soy tan mortal como... er... la muerte!"

msgid "Enjoy your last moments as they are your… er… last moments!"
msgstr ""
"Disfruta de tus últimos momentos, ya que son tus... eh... ¡últimos momentos!"

msgid "Ahahahahah!"
msgstr "¡Ahahahahah!"

msgid "I know no mercy!"
msgstr "¡No conozco la piedad!"

msgid "I am cruel and ruthless! And heartless! And… and unkind!"
msgstr "¡Soy cruel y despiadado! ¡Y despiadado! ¡Y... y cruel!"

msgid "Your destiny is sealed!"
msgstr "¡Tu destino está sellado!"

msgid "Hey? Stop shooting at me!"
msgstr "¿Oye? ¡Deja de dispararme!"

msgid "Please don't kill me!"
msgstr "¡Por favor, no me mates!"

msgid "I beg you!"
msgstr "¡Te lo ruego!"

msgid "Noooooooo!"
msgstr "¡Nooooooo!"

msgid "Please! Have mercy!"
msgstr "¡Por favor! ¡Ten piedad!"

msgid "I can make you rich if you spare my life!"
msgstr "¡Puedo hacerte rico si me perdonas la vida!"

