#. --
#.
#. Event handling the gambling stuff going on at Minerva station
#. --
#. local love_shaders = require 'love_shaders'
#. Non-persistent state
#. NPC Stuff
#. Becomes a random NPC
#. TODO replace?
#. Special
msgid "Patron"
msgstr "Cliente"

msgid "A gambling patron enjoying their time at the station."
msgstr "Un cliente del juego disfrutando de su tiempo en la estación."

msgid ""
"A tourist looking a bit bewildered at all the noises and shiny lights all "
"over."
msgstr ""
"Un turista que parece un poco desconcertado por todos los ruidos y luces "
"brillantes que hay por todas partes."

msgid "A patron who seems down on their luck."
msgstr "Un cliente que parece tener mala suerte."

msgid "A patron who looks exhilarated as if they won big today."
msgstr ""
"Un cliente que parece exultante, como si hoy hubiera ganado a lo grande."

#, fuzzy
msgid ""
"A patron that looks like they have spent a lot of time at the station. There "
"are clear dark circles under their eyes."
msgstr ""
"Un cliente que parece haber pasado mucho tiempo en la estación. Tiene unas "
"claras ojeras."

msgid "A patron that looks strangely out of place."
msgstr "Un cliente que parece extrañamente fuera de lugar."

msgid "A patron that fits in perfectly into the gambling station."
msgstr "Un cliente que encaja perfectamente en la estación de juego."

msgid ""
"\"This place is totally what I thought it would be. The lights, the sounds, "
"the action! I feel like I'm in Heaven!\""
msgstr ""
"\"Este lugar es totalmente lo que pensé que sería. ¡Las luces, los sonidos, "
"la acción! ¡Me siento como en el Cielo!\""

msgid ""
"\"It's incredible! Who would have thought to make money physical! These "
"Minerva Tokens defy all logic!\""
msgstr ""
"\"¡Es increíble! ¡Quién hubiera pensado en hacer dinero físico! ¡Estas "
"Fichas de Minerva desafían toda lógica!\""

msgid " Wait, what? What do you mean the Fuzzy Dice are sold out!?"
msgstr ""
" Espera, ¿qué? ¿Qué quieres decir con que los Dados Peludos se han agotado?"

msgid ""
"\"I really have my eyes on the Fuzzy Dice available at the terminal. I "
"always wanted to own a piece of history!{msg}\""
msgstr ""
"\"Le he echado el ojo a los Dados Borrosos disponibles en la terminal. "
"¡Siempre quise tener un pedazo de historia! {msg}\""

msgid ""
"\"They say the station always wins, but that doesn't stop us from trying!\""
msgstr ""
"\"Dicen que la estación siempre gana, ¡pero eso no nos impide intentarlo!\""

msgid ""
"\"I played 20 hands of blackjack with that Cyborg Chicken. I may have lost "
"them all, but that was worth every credit!\""
msgstr ""
"\"He jugado 20 manos de blackjack con ese Pollo Cyborg. ¡Puede que las haya "
"perdido todas, pero ha valido la pena cada crédito!\""

#, fuzzy
msgid ""
"\"I've seen folks come in with nothing and leave with a brand-new Kestrel! "
"Minerva station is a crazy place!\""
msgstr ""
"\"¡He visto a gente entrar sin nada y salir con un flamante Cernícalo! ¡La "
"estación de Minerva es una locura!\""

msgid ""
"\"This place is great! I still have no idea how to play blackjack, but I "
"just keep on playing again and again against that Cyborg Chicken.\""
msgstr ""
"\"¡Este lugar es genial! Todavía no tengo ni idea de cómo jugar al "
"blackjack, pero sigo jugando una y otra vez contra ese Pollo Cyborg.\""

#, fuzzy
msgid ""
"\"Critics of Minerva Station say that being able to acquire nice outfits "
"here without needing licences increases piracy. I think they are all lame!\""
msgstr ""
"\"Los críticos de la estación Minerva dicen que poder adquirir aquí bonitos "
"complementos sin necesidad de licencias aumenta la piratería. ¡Yo creo que "
"son todos unos lerdos!\""

msgid ""
"\"I really want to go to the VIP hot springs they have, but I don't have the "
"tokens. How does that even work in a space station?\""
msgstr ""
"\"Tengo muchas ganas de ir a las termas VIP que tienen, pero no tengo las "
"fichas. ¿Cómo funciona eso en una estación espacial?\""

msgid ""
"\"I hear you can do all sorts of crazy stuff here if you have enough tokens. "
"Need… to… get… more…!\""
msgstr ""
"\"He oído que puedes hacer todo tipo de locuras aquí si tienes suficientes "
"fichas. ¡Necesito... conseguir... más...!\""

msgid ""
"\"I have never seen robots talk so roboty like the terminals here. That is "
"so retro!\""
msgstr ""
"\"Nunca he visto a los robots hablar de forma tan robótica como los "
"terminales de aquí. ¡Es tan retro!\""

msgid ""
"\"I scrounged up my lifetime savings to get a ticket here, but I forgot to "
"bring extra to gamble…\""
msgstr ""
"\"He reunido mis ahorros de toda la vida para conseguir un billete aquí, "
"pero me olvidé de traer algo extra para apostar...\""

msgid ""
"\"I gambled all my savings away… I'm going to get killed when I get back "
"home…\""
msgstr ""
"\"Me he jugado todos mis ahorros... Me van a matar cuando vuelva a casa...\""

#, fuzzy
msgid ""
"\"They say you shouldn't gamble more than you can afford to lose. I wish "
"someone had told me that yesterday. I don't even own a ship any more!\""
msgstr ""
"\"Dicen que no debes apostar más de lo que puedes permitirte perder. Ojalá "
"alguien me hubiera dicho eso ayer. ¡Ya ni siquiera tengo una nave!\""

#, fuzzy
msgid ""
"\"I like to play blackjack. I'm not addicted to gambling. I'm addicted to "
"sitting in a semicircle.\""
msgstr ""
"\"Me gusta jugar al blackjack. No soy adicto al juego. Soy adicto a sentarme "
"en un semicírculo.\""

#. Mitch Hedberg
msgid ""
"\"Gambling has brought our family together. We had to move to a smaller "
"house.\""
msgstr ""
"\"El juego ha unido a nuestra familia. Tuvimos que mudarnos a una casa más "
"pequeña.\""

#. Tommy Cooper
msgid "\"You don’t gamble to win. You gamble so you can gamble the next day.\""
msgstr ""
"\"No se juega para ganar. Se juega para poder jugar al día siguiente.\""

#. Bert Ambrose
msgid "\"A credit won is twice as sweet as a credit earned!\""
msgstr ""
"\"¡Un crédito ganado jugando es dos veces más dulce que un crédito ganado "
"trabajando!\""

#. Paul Newman (dollar -> credit)
msgid ""
"\"There is a very easy way to return from Minerva Station with a small "
"fortune: come here with a large one!\""
msgstr ""
"\"Hay una forma muy fácil de volver de la Estación Minerva con una pequeña "
"fortuna: ¡venir aquí con una grande!\""

#. Jack Yelton (paraphrased)
#, fuzzy
msgid "\"Luck always seems to be against the ones who depend on it.\""
msgstr ""
"\"La suerte siempre parece estar en contra de los que dependen de ella.\""

#. local minerva_end = (diff.isApplied("minerva_3") or diff.isApplied("minerva_3d") or diff.isApplied("minerva_3z"))
#. Station is not "usable"
#. Create NPCs
msgid "Blackjack"
msgstr "Blackjack"

msgid "Seems to be one of the more popular card games."
msgstr "Parece ser uno de los juegos de cartas más populares."

msgid ""
"Seems to be one of the more popular card games where you can play blackjack "
"against a \"cyborg chicken\"."
msgstr ""
"Parece ser uno de los juegos de cartas más populares porque puedes jugar al "
"blackjack contra un \"pollo cyborg\"."

msgid "Chuck-a-luck"
msgstr "Chuck-a-luck"

msgid "A fast-paced luck-based betting game using dice."
msgstr ""
"Un juego de apuestas de ritmo rápido basado en la suerte y que utiliza dados."

#. Some conditional NPCs
msgid "You see Maikki enjoying a parfait."
msgstr "Ves a Maikki disfrutando de un parfait."

msgid "You see Maikki talking on a transponder."
msgstr "Ves a Maikki hablando por un transpondedor."

