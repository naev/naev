#. <mission name="Dvaered Colonel Escort">
#. <unique />
#. <chance>18</chance>
#. <location>Bar</location>
#. <faction>Dvaered</faction>
#. <cond>
#. if spob.cur():reputation("Dvaered") &lt; 0 then
