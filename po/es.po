#. Add tag-appropriate descriptions
msgid "Dreamer Soul"
msgstr "Alma Soñadora"

#. local fmt = require "format"
#. State. Nothing persists.
msgid "The civilian is curling some weights while enjoying a drink."
msgstr "El civil está pensando mientras disfruta de una copa."

msgid "You see a person who seems to be flexing their muscles while drinking."
msgstr "Ves a una persona que parece flexionar los músculos mientras bebe."

msgid ""
"The individual has a large assortment of empty glasses in front of them."
msgstr "El individuo tiene ante sí un gran surtido de vasos vacíos."

msgid "A civilian downing drinks one after another."
msgstr "Un civil que bebe una copa tras otra."

msgid ""
"This person does their best to read the news terminal despite having a black "
"eye."
msgstr ""
"Esta persona hace todo lo posible por leer el terminal de noticias a pesar "
"de tener un ojo morado."

msgid "The person has leaves stuck all over them."
msgstr "La persona tiene hojas pegadas por todas partes."

msgid "The individual is covered in smut."
msgstr "El individuo está cubierto de hollín."

msgid "A civilian with a thin layer of grime on them."
msgstr "Un civil con una fina capa de mugre encima."

msgid "A worker with lots of small pebbles falling off of them."
msgstr "Un trabajador al que se le caen multitud de piedrecitas de su ropa."

msgid "This worker wears a badge that reads \"Miner of the Cycle\"."
msgstr ""
"Este trabajador lleva una insignia en la que se lee \"Minero del Ciclo\"."

