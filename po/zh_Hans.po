msgid "{fname} Territory"
msgstr "{fname}领土"

msgid "The Nebula"
msgstr "星云"

msgid "Grim Reminder of Our Fragility"
msgstr "残酷的提醒我们的脆弱"

msgid "Northern Stellar Winds"
msgstr "北方恒星风"

#. subtitle = _("None"),
msgid "Southern Stellar Winds"
msgstr "南方恒星风"

