#. Forward declaration
msgid "Machiavellian Misi"
msgstr "马基雅维利式的米西"

#. Mireia Sibeko
#. TODO for some reason it doesn't like setting the ai first, gives an
#. error that we can't really trace atm
#. local ep = pilot.add("Escape Pod", p:faction(), p:pos(), nil, {ai="escape_pod"} )
#. matrices
