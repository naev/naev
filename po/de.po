#.
#. <?xml version='1.0' encoding='utf8'?>
#. <mission name="Invitation">
#. <unique />
#. <priority>3</priority>
#. <done>Unfair Competition</done>
#. <chance>50</chance>
#. <location>Bar</location>
#. <spob>Darkshed</spob>
