msgid "This is Obstinate. Launching bombers."
msgstr "Hier spricht Obstinate. Wir entsenden Bomber."

msgid ""
"WARNING: dv_antiflf03: going to next stage, but next stage doesn't exist!"
msgstr ""
"ACHTUNG: dv_antiflf03: gehe zur nächsten Phase, aber nächste Phase existiert "
"nicht!"

