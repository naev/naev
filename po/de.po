#. Main Characters
msgid "Cyborg Chicken"
msgstr "Cyborg-Huhn"

msgid ""
"\"MINERVA STATION IS THE BEST PLACE TO SIT BACK AND ENJOY RELAXING GAMBLING "
"ACTIVITIES. ALTHOUGH THE AREA IS HEAVILY DISPUTED BY THE ZA'LEK AND DVAERED, "
"REST ASSURED THAT THERE IS LESS THAN A 2% OF CHANCE OF TOTAL DESTRUCTION OF "
"THE STATION.\""
msgstr ""
"„DIE MINERVA-STATION IST DER BESTE ORT, UM SICH ZURÜCKZULEHNEN UND "
"ENTSPANNTE GLÜCKSSPIELE ZU GENIESSEN. OBWOHL DAS GEBIET VON DEN ZA'LEK UND "
"DVAERED STARK UMKÄMPFT IST, KÖNNEN SIE SICHER SEIN, DASS DIE CHANCE EINER "
"TOTALEN ZERSTÖRUNG DER STATION WENIGER ALS 2% BETRÄGT.“"

msgid ""
"\"WHILE GAMBLING IS NOT ALLOWED IN MOST OF THE EMPIRE, MINERVA STATION "
"BOASTS OF AN EXCLUSIVE STATUS THANKS TO THE IMPERIAL DECREE 289.78 ARTICLE "
"478 SECTION 19 ALLOWING GAMBLING TO BE ENJOYED WITHOUT RESTRICTIONS. IT IS "
"POSSIBLE TO PLAY GAMES USING CREDITS TO OBTAIN MINERVA TOKENS THAT CAN BE "
"TRADED IN FOR GOODS AND SERVICES ANY TERMINAL THROUGHOUT THE STATION.\""
msgstr ""
"„OBWOHL GLÜCKSSPIELE IN DEN MEISTEN TEILEN DES IMPERIUMS NICHT ERLAUBT SIND, "
"RÜHMT SICH DIE MINERVA-STATION EINES EXKLUSIVEN STATUS DANK DES IMPERIALEN "
"ERLASSES 289.78 ARTIKEL 478 ABSCHNITT 19, DER ES ERLAUBT, GLÜCKSSPIELE OHNE "
"EINSCHRÄNKUNGEN ZU GENIESSEN. ES IST MÖGLICH, SPIELE MIT CREDITS ZU SPIELEN, "
"UM MINERVA-JETONS ZU ERHALTEN, DIE AN JEDEM TERMINAL AUF DER STATION GEGEN "
"WAREN UND DIENSTLEISTUNGEN EINGETAUSCHT WERDEN KÖNNEN.“"

#, fuzzy
msgid ""
"\"IT IS POSSIBLE TO TRADE MINERVA TOKENS FOR GOODS AND SERVICES AT TERMINALS "
"THROUGHOUT THE STATION. THANKS TO THE IMPERIAL DECREE 289.78 ARTICLE 478 "
"SECTION 72, ALL TRADE-INS ARE NOT SUBJECT TO STANDARD IMPERIAL LICENCE "
"RESTRICTIONS. FURTHERMORE, THEY ALL HAVE 'I Got This Sucker at Minerva "
"Station' ENGRAVED ON THEM.\""
msgstr ""
"„ES IST MÖGLICH, MINERVA-JETONS GEGEN WAREN UND DIENSTLEISTUNGEN AN "
"TERMINALS IN DER GESAMTEN STATION EINZUTAUSCHEN. DANK DES IMPERIALEN "
"ERLASSES 289.78 ARTIKEL 478 ABSCHNITT 72 UNTERLIEGEN ALLE EINTAUSCHGESCHÄFTE "
"NICHT DEN ÜBLICHEN IMPERIALEN LIZENZBESCHRÄNKUNGEN. DARÜBER HINAUS HABEN SIE "
"ALLE ‚Ich hab dieses Teil von Minerva-Station“ EINGRAVIERT.“"

#, fuzzy
msgid ""
"\"CYBORG CHICKEN IS OUR MOST POPULAR BLACKJACK DEALER. NOWHERE ELSE IN THE "
"UNIVERSE WILL YOU BE ABLE TO PLAY CARD GAMES WITH AN AI-ENHANCED CHICKEN "
"CYBORG. IT IS A ONCE AND A LIFE-TIME CHANCE THAT YOU SHOULD NOT MISS.\""
msgstr ""
"„CYBORG-HUHN IST UNSER BELIEBTESTER BLACKJACK-CROUPIER. NIRGENDWO SONST IM "
"UNIVERSUM WERDEN SIE DIE MÖGLICHKEIT HABEN, KARTENSPIELE MIT EINEM AI-"
"VERBESSERTEN CYBORG-HUHN ZU SPIELEN. ES IST EINE EINMALIGE CHANCE, DIE SIE "
"SICH NICHT ENTGEHEN LASSEN SOLLTEN.“"

msgid ""
"\"SORRY, YOU DO NOT HAVE ENOUGH MINERVA TOKENS TO TRADE-IN FOR YOUR "
"REQUESTED ITEM. WOULD YOU LIKE TO TRADE-IN FOR SOMETHING ELSE? YOU HAVE "
"#p{n} MINERVA TOKEN#0.\""
msgid_plural ""
"\"SORRY, YOU DO NOT HAVE ENOUGH MINERVA TOKENS TO TRADE-IN FOR YOUR "
"REQUESTED ITEM. WOULD YOU LIKE TO TRADE-IN FOR SOMETHING ELSE? YOU HAVE "
"#p{n} MINERVA TOKENS#0.\""
msgstr[0] ""
"„TUT MIR LEID, SIE HABEN NICHT GENUG MINERVA-JETONS, UM DEN GEWÜNSCHTEN "
"GEGENSTAND EINZUTAUSCHEN. MÖCHTEN SIE GEGEN ETWAS ANDERES EINTAUSCHEN? SIE "
"HABEN #p{n} MINERVA-JETON#0.“"
msgstr[1] ""
"„TUT MIR LEID, SIE HABEN NICHT GENUG MINERVA-JETONS, UM DEN GEWÜNSCHTEN "
"GEGENSTAND EINZUTAUSCHEN. MÖCHTEN SIE GEGEN ETWAS ANDERES EINTAUSCHEN? SIE "
"HABEN #p{n} MINERVA-JETONS#0.“"

msgid ""
"\"I AM SORRY TO INFORM YOU THAT THE ITEM THAT YOU DESIRE IS CURRENTLY SOLD "
"OUT. WOULD YOU LIKE TO TRADE-IN FOR SOMETHING ELSE? YOU HAVE #p{n} MINERVA "
"TOKEN#0.\""
msgid_plural ""
"\"I AM SORRY TO INFORM YOU THAT THE ITEM THAT YOU DESIRE IS CURRENTLY SOLD "
"OUT. WOULD YOU LIKE TO TRADE-IN FOR SOMETHING ELSE? YOU HAVE #p{n} MINERVA "
"TOKENS#0.\""
msgstr[0] ""
"„ES TUT MIR LEID, IHNEN MITTEILEN ZU MÜSSEN, DASS DER VON IHNEN GEWÜNSCHTE "
"ARTIKEL DERZEIT AUSVERKAUFT IST. MÖCHTEN SIE IHN GEGEN ETWAS ANDERES "
"EINTAUSCHEN? SIE HABEN #p{n} MINERVA-JETON#0.“"
msgstr[1] ""
"„ES TUT MIR LEID, IHNEN MITTEILEN ZU MÜSSEN, DASS DER VON IHNEN GEWÜNSCHTE "
"ARTIKEL DERZEIT AUSVERKAUFT IST. MÖCHTEN SIE IHN GEGEN ETWAS ANDERES "
"EINTAUSCHEN? SIE HABEN #p{n} MINERVA-JETONS#0.“"

msgid ""
"\"YOU CAN TRADE IN YOUR PRECIOUS #p{n} MINERVA TOKEN#0 FOR THE FOLLOWING "
"GOODS.\""
msgid_plural ""
"\"YOU CAN TRADE IN YOUR PRECIOUS #p{n} MINERVA TOKENS#0 FOR THE FOLLOWING "
"GOODS.\""
msgstr[0] ""
"„SIE KÖNNEN IHREN KOSTBAREN #p{n} MINERVA-JETON#0 GEGEN DIE FOLGENDEN WAREN "
"EINTAUSCHEN.“"
msgstr[1] ""
"„SIE KÖNNEN IHRE KOSTBAREN #p{n} MINERVA-JETONS#0 GEGEN DIE FOLGENDEN WAREN "
"EINTAUSCHEN.“"

