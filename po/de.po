#.
#. <?xml version='1.0' encoding='utf8'?>
#. <mission name="Waste Dump">
#. <priority>9</priority>
#. <chance>10</chance>
#. <location>Computer</location>
#. <cond>
#. local f = spob.cur():faction()
#. if f then
#. local ft = f:tags()
